Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 5
      Class: rviz_default_plugins/Grid
      Color: 100; 100; 100
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Value: true
    - Alpha: 0.65
      Autocompute Intensity Bounds: true
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Name: LiDAR
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: false
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calib/lidar
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 0.3
      Class: rviz_default_plugins/PointCloud2
      Color: 150; 150; 150
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Radar Original
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: false
      Size (Pixels): 7
      Style: Flat Squares
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calib/radar_original
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 70; 20
      Color Transformer: FlatColor
      Decay Time: 0.15
      Enabled: true
      Name: Radar Adjusted
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: true
      Size (Pixels): 18
      Style: Flat Squares
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /calib/radar_adjusted
      Use Fixed Frame: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 20; 20
    Fixed Frame: rslidar
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 45
      Focal Point:
        X: 25
        Y: 0
        Z: 0
      Name: Manual Translation
      Pitch: 1.35
      Target Frame: rslidar
      Yaw: 3.14
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
  X: 30
  Y: 30

Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 5
      Class: rviz_default_plugins/Grid
      Color: 100; 100; 100
      Enabled: true
      Name: Range Grid
      Plane: XY
      Plane Cell Count: 40
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: Intensity
      Decay Time: 0.15
      Enabled: true
      Name: RS LiDAR
      Position Transformer: XYZ
      Queue Size: 3
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 3
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lidar/points
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: Intensity
      Decay Time: 0.3
      Enabled: true
      Name: ARS-40X Radar
      Position Transformer: XYZ
      Queue Size: 3
      Selectable: true
      Size (Pixels): 10
      Size (m): 0.45
      Style: Flat Squares
      Topic:
        Depth: 3
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /radar/points
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
  Enabled: true
  Global Options:
    Background Color: 22; 22; 22
    Fixed Frame: rslidar
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 55
      Focal Point:
        X: 25
        Y: 0
        Z: 0
      Name: LiDAR and Radar
      Pitch: 1.15
      Target Frame: rslidar
      Yaw: 3.14
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
  X: 30
  Y: 30
